# Copy this file to ".env" for local development, and set these same
# variables in your hosting service (e.g. Render) for production.

# Port the server listens on (Render sets this automatically).
PORT=5000

# MongoDB connection string.
#  - Local:      mongodb://127.0.0.1:27017/peerlearn
#  - Production: your MongoDB Atlas connection string (with db name /peerlearn)
MONGO_URI=mongodb://127.0.0.1:27017/peerlearn

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# (Production only) Your frontend's URL, to restrict who can call the API.
# Example: https://peerlearn.vercel.app
# Leave unset locally to allow all origins.
# CLIENT_URL=https://your-frontend-domain
