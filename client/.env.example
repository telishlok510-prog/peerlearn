# Copy this file to ".env" for local development if needed.
# Set this same variable in your frontend host (e.g. Vercel) for production.

# The deployed backend API URL (must end with /api).
# Example: https://peerlearn-api.onrender.com/api
# When unset, the app falls back to http://localhost:5000/api for local dev.
VITE_API_URL=
